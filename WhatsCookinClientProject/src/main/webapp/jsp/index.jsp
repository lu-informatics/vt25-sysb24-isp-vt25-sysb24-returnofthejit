<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>What's Cookin'</title>
  <link rel="stylesheet" href="styles.css" />
  <link href="https://fonts.googleapis.com/css2?family=Moo+Lah+Lah&display=swap" rel="stylesheet">
</head>
<body>
  <div class="container">
    <h1>What’s Cookin’</h1>
    <div class="form-box">
      <h2>Create an account</h2>
      <p>Enter a username and password</p>
      <input type="text" placeholder="adam123" />
      <input type="password" placeholder="password123" />
      <button>Create account</button>
      <p class="alt">Already have an account?</p>
      <input type="text" placeholder="Username" />
      <input type="password" placeholder="Password" />
      <button>Log in</button>
    </div>
  </div>
</body>
</html>
